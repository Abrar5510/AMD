# Copy to .env and fill in. Never commit .env.

# Hugging Face token with the Gemma license accepted (huggingface.co/google/gemma-3-12b-it).
HF_TOKEN=

# google/gemma-3-12b-it (start here) or google/gemma-3-27b-it (compare latency).
MODEL=google/gemma-3-12b-it

VLLM_IMAGE=rocm/vllm:latest
MAX_MODEL_LEN=16384
GPU_MEM_UTIL=0.6

# Optional. If set, vLLM requires it as a Bearer token and the app/smoke test send it.
VLLM_API_KEY=

# Required for a public app URL: protects upload/draft/edit/approve. Open the page with ?token=<value>.
APP_TOKEN=

# Authoring speech-to-text. openai/whisper-tiny.en for quick CPU tests.
WHISPER_MODEL=openai/whisper-large-v3-turbo

# Fast tier. Use google/siglip-base-patch16-224 for quick CPU tests on a laptop.
SIGLIP_MODEL=google/siglip-so400m-patch14-384

# Coach calibration knobs (defaults in app/coach.py Config). Uncomment to tune at the venue.
# COACH_ENTER_T=0.5
# COACH_CONFIDENT_T=0.6
# COACH_ASK_T=0.4
# COACH_TEMP=0.02
# COACH_HEARTBEAT_S=2.0
# COACH_COOLDOWN_S=8.0
